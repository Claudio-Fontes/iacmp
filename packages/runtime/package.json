{
  "name": "@iacmp/runtime",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "description": "Interface neutra de runtime (Table/Blob) para handlers multi-cloud do iacmp — o adaptador de cada cloud é resolvido no bundle/deploy",
  "author": "Claudio Melo",
  "repository": {
    "type": "git",
    "url": "https://github.com/Claudio-Fontes/iacmp",
    "directory": "packages/runtime"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./aws": {
      "types": "./dist/aws/index.d.ts",
      "default": "./dist/aws/index.js"
    },
    "./azure": {
      "types": "./dist/azure/index.d.ts",
      "default": "./dist/azure/index.js"
    },
    "./gcp": {
      "types": "./dist/gcp/index.d.ts",
      "default": "./dist/gcp/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "*",
    "@aws-sdk/client-s3": "*",
    "@aws-sdk/client-secrets-manager": "*",
    "@aws-sdk/client-sqs": "*",
    "@aws-sdk/lib-dynamodb": "*",
    "@aws-sdk/s3-request-presigner": "*",
    "@azure/identity": "*",
    "@azure/keyvault-secrets": "*",
    "@azure/service-bus": "*",
    "@azure/storage-blob": "*",
    "@google-cloud/firestore": "*",
    "@google-cloud/pubsub": "*",
    "@google-cloud/secret-manager": "*",
    "@google-cloud/storage": "*",
    "ioredis": "*",
    "mongodb": "*",
    "pg": "*"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    },
    "@aws-sdk/client-sqs": {
      "optional": true
    },
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    },
    "@azure/keyvault-secrets": {
      "optional": true
    },
    "@azure/service-bus": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "@google-cloud/firestore": {
      "optional": true
    },
    "@google-cloud/pubsub": {
      "optional": true
    },
    "@google-cloud/secret-manager": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1093.0",
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/client-secrets-manager": "^3.1093.0",
    "@aws-sdk/client-sqs": "^3.1093.0",
    "@aws-sdk/lib-dynamodb": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@azure/identity": "^4.0.0",
    "@azure/keyvault-secrets": "^4.8.0",
    "@azure/service-bus": "^7.9.0",
    "@azure/storage-blob": "12.33.0",
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/pubsub": "^4.7.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/storage": "^7.14.0",
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "ioredis": "^5.4.0",
    "jest": "^29",
    "mongodb": "^6.10.0",
    "pg": "^8.13.0",
    "ts-jest": "^29",
    "typescript": "^5.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
