{
  "terraform": {
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": "~> 5.0"
      }
    }
  },
  "provider": {
    "google": {
      "project": "${var.project_id}",
      "region": "${var.gcp_region}"
    }
  },
  "variable": {
    "project_id": {
      "type": "string"
    },
    "gcp_region": {
      "type": "string",
      "default": "us-central1"
    }
  },
  "resource": {
    "google_cloud_run_v2_service": {
      "appservice": {
        "name": "appservice",
        "location": "${var.gcp_region}",
        "template": [
          {
            "containers": [
              {
                "image": "gcr.io/IACMP_BUILD_PLACEHOLDER/appservice:latest",
                "resources": [
                  {
                    "limits": {
                      "cpu": "1",
                      "memory": "512Mi"
                    }
                  }
                ],
                "ports": [
                  {
                    "container_port": 8080
                  }
                ],
                "env": []
              }
            ],
            "scaling": [
              {
                "min_instance_count": 0,
                "max_instance_count": 10
              }
            ]
          }
        ],
        "ingress": "INGRESS_TRAFFIC_ALL"
      }
    },
    "google_cloud_run_v2_service_iam_member": {
      "appservice_public": {
        "name": "${google_cloud_run_v2_service.appservice.name}",
        "location": "${var.gcp_region}",
        "role": "roles/run.invoker",
        "member": "allUsers"
      }
    }
  },
  "output": {
    "AppServiceServiceUrl": {
      "value": "${google_cloud_run_v2_service.appservice.uri}"
    }
  }
}
