{
  "terraform": {
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": "~> 5.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.0"
      }
    }
  },
  "provider": {
    "google": {
      "project": "${var.project_id}",
      "region": "${var.gcp_region}"
    }
  },
  "variable": {
    "project_id": {
      "type": "string"
    },
    "gcp_region": {
      "type": "string",
      "default": "us-central1"
    }
  },
  "resource": {
    "google_compute_global_address": {
      "appvpc_psa_range": {
        "name": "appvpc-psa-range",
        "purpose": "VPC_PEERING",
        "address_type": "INTERNAL",
        "prefix_length": 16,
        "network": "${google_compute_network.appvpc.id}"
      }
    },
    "google_service_networking_connection": {
      "appvpc_psa": {
        "network": "${google_compute_network.appvpc.id}",
        "service": "servicenetworking.googleapis.com",
        "reserved_peering_ranges": [
          "${google_compute_global_address.appvpc_psa_range.name}"
        ]
      }
    },
    "google_compute_network": {
      "appvpc": {
        "name": "appvpc",
        "auto_create_subnetworks": false,
        "routing_mode": "REGIONAL"
      }
    },
    "google_sql_database_instance": {
      "privatedb": {
        "name": "privatedb",
        "database_version": "POSTGRES_15",
        "region": "${var.gcp_region}",
        "settings": [
          {
            "tier": "db-f1-micro",
            "backup_configuration": [
              {
                "enabled": true
              }
            ],
            "availability_type": "ZONAL",
            "ip_configuration": [
              {
                "ipv4_enabled": false,
                "private_network": "${google_compute_network.appvpc.id}"
              }
            ]
          }
        ],
        "deletion_protection": false,
        "depends_on": [
          "google_service_networking_connection.appvpc_psa"
        ]
      }
    },
    "random_password": {
      "privatedb_dbpassword": {
        "length": 20,
        "special": false
      }
    },
    "google_sql_user": {
      "privatedb_dbuser": {
        "name": "postgres",
        "instance": "${google_sql_database_instance.privatedb.name}",
        "password": "${random_password.privatedb_dbpassword.result}",
        "deletion_policy": "ABANDON"
      }
    },
    "google_vpc_access_connector": {
      "appvpc_vpc_connector": {
        "name": "appvpc-con",
        "region": "${var.gcp_region}",
        "network": "${google_compute_network.appvpc.id}",
        "ip_cidr_range": "10.8.0.0/28"
      }
    },
    "google_cloudfunctions2_function": {
      "workerfn": {
        "name": "WorkerFn",
        "location": "${var.gcp_region}",
        "build_config": [
          {
            "runtime": "nodejs20",
            "entry_point": "handler",
            "source": [
              {
                "storage_source": [
                  {
                    "bucket": "${var.project_id}-artifacts",
                    "object": "workerfn.zip"
                  }
                ]
              }
            ]
          }
        ],
        "service_config": [
          {
            "available_memory": "128Mi",
            "timeout_seconds": 30,
            "environment_variables": {
              "IACMP_CLOUD": "gcp",
              "DB_HOST": "${google_sql_database_instance.privatedb.private_ip_address}",
              "DB_PORT": "5432",
              "DB_USER": "${google_sql_user.privatedb_dbuser.name}",
              "DB_PASSWORD": "${random_password.privatedb_dbpassword.result}"
            },
            "vpc_connector": "${google_vpc_access_connector.appvpc_vpc_connector.id}",
            "vpc_connector_egress_settings": "PRIVATE_RANGES_ONLY"
          }
        ]
      }
    },
    "google_cloud_run_v2_service_iam_member": {
      "workerfn_public": {
        "project": "${var.project_id}",
        "location": "${var.gcp_region}",
        "name": "${lower(google_cloudfunctions2_function.workerfn.name)}",
        "role": "roles/run.invoker",
        "member": "allUsers"
      }
    }
  },
  "output": {
    "PrivateDbConnectionName": {
      "value": "${google_sql_database_instance.privatedb.connection_name}"
    },
    "WorkerFnFunctionUrl": {
      "value": "${google_cloudfunctions2_function.workerfn.service_config[0].uri}"
    }
  }
}
