{
  "terraform": {
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": "~> 5.0"
      }
    }
  },
  "provider": {
    "google": {
      "project": "${var.project_id}",
      "region": "${var.gcp_region}"
    }
  },
  "variable": {
    "project_id": {
      "type": "string"
    },
    "gcp_region": {
      "type": "string",
      "default": "us-central1"
    }
  },
  "resource": {
    "google_cloudfunctions2_function": {
      "connectfn": {
        "name": "ConnectFn",
        "location": "${var.gcp_region}",
        "build_config": [
          {
            "runtime": "nodejs20",
            "entry_point": "handler",
            "source": [
              {
                "storage_source": [
                  {
                    "bucket": "${var.project_id}-artifacts",
                    "object": "connectfn.zip"
                  }
                ]
              }
            ]
          }
        ],
        "service_config": [
          {
            "available_memory": "128Mi",
            "timeout_seconds": 30,
            "environment_variables": {
              "IACMP_CLOUD": "gcp"
            }
          }
        ]
      },
      "disconnectfn": {
        "name": "DisconnectFn",
        "location": "${var.gcp_region}",
        "build_config": [
          {
            "runtime": "nodejs20",
            "entry_point": "handler",
            "source": [
              {
                "storage_source": [
                  {
                    "bucket": "${var.project_id}-artifacts",
                    "object": "disconnectfn.zip"
                  }
                ]
              }
            ]
          }
        ],
        "service_config": [
          {
            "available_memory": "128Mi",
            "timeout_seconds": 30,
            "environment_variables": {
              "IACMP_CLOUD": "gcp"
            }
          }
        ]
      },
      "defaultfn": {
        "name": "DefaultFn",
        "location": "${var.gcp_region}",
        "build_config": [
          {
            "runtime": "nodejs20",
            "entry_point": "handler",
            "source": [
              {
                "storage_source": [
                  {
                    "bucket": "${var.project_id}-artifacts",
                    "object": "defaultfn.zip"
                  }
                ]
              }
            ]
          }
        ],
        "service_config": [
          {
            "available_memory": "128Mi",
            "timeout_seconds": 30,
            "environment_variables": {
              "IACMP_CLOUD": "gcp"
            }
          }
        ]
      }
    },
    "google_cloud_run_v2_service_iam_member": {
      "connectfn_public": {
        "project": "${var.project_id}",
        "location": "${var.gcp_region}",
        "name": "${lower(google_cloudfunctions2_function.connectfn.name)}",
        "role": "roles/run.invoker",
        "member": "allUsers"
      },
      "disconnectfn_public": {
        "project": "${var.project_id}",
        "location": "${var.gcp_region}",
        "name": "${lower(google_cloudfunctions2_function.disconnectfn.name)}",
        "role": "roles/run.invoker",
        "member": "allUsers"
      },
      "defaultfn_public": {
        "project": "${var.project_id}",
        "location": "${var.gcp_region}",
        "name": "${lower(google_cloudfunctions2_function.defaultfn.name)}",
        "role": "roles/run.invoker",
        "member": "allUsers"
      }
    },
    "google_cloud_run_v2_service": {
      "wsapi": {
        "name": "wsapi",
        "location": "${var.gcp_region}",
        "template": [
          {
            "session_affinity": true,
            "timeout": "3600s",
            "containers": [
              {
                "image": "gcr.io/${var.project_id}/defaultfn:latest",
                "ports": [
                  {
                    "container_port": 8080
                  }
                ]
              }
            ],
            "scaling": [
              {
                "min_instance_count": 0,
                "max_instance_count": 10
              }
            ]
          }
        ],
        "ingress": "INGRESS_TRAFFIC_ALL"
      }
    }
  },
  "output": {
    "ConnectFnFunctionUrl": {
      "value": "${google_cloudfunctions2_function.connectfn.service_config[0].uri}"
    },
    "DisconnectFnFunctionUrl": {
      "value": "${google_cloudfunctions2_function.disconnectfn.service_config[0].uri}"
    },
    "DefaultFnFunctionUrl": {
      "value": "${google_cloudfunctions2_function.defaultfn.service_config[0].uri}"
    },
    "WsApiWebSocketUrl": {
      "value": "${google_cloud_run_v2_service.wsapi.uri}"
    }
  }
}
